# Backend the emitter POSTs coarse events to
BACKEND_URL=https://your-backend.example.com
ACCOUNT_TOKEN=replace-with-the-same-long-random-string-as-the-backend
# Happy server the adapter connects to (optional; defaults to the public Happy server)
HAPPY_SERVER_URL=https://api.cluster-fluster.com
# Optional override of the Happy home dir (defaults to ~/.happy)
# HAPPY_HOME_DIR=/Users/you/.happy
