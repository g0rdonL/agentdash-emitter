# Backend the emitter POSTs coarse events to
BACKEND_URL=https://your-backend.example.com
ACCOUNT_TOKEN=replace-with-the-same-long-random-string-as-the-backend
# Happy server the adapter connects to (optional; defaults to the public Happy server)
HAPPY_SERVER_URL=https://api.cluster-fluster.com
# Optional override of the Happy home dir (defaults to ~/.happy)
# HAPPY_HOME_DIR=/Users/you/.happy
# Disable standalone Claude poller (set to 0 to skip)
# CLAUDE_POLLER=0

# Paseo daemon agent poller (disabled via PASEO_POLLER=0)
PASEO_POLLER=0
# Paseo daemon HTTP endpoint (defaults to http://127.0.0.1:6767)
# PASEO_BASE_URL=http://127.0.0.1:6767
# Paseo agent state directory (defaults to ~/.paseo/agents)
# PASEO_AGENTS_DIR=~/.paseo/agents
# Poll interval in seconds (default 5)
# POLL_INTERVAL_SEC=5
# Idle TTL in minutes before an idle agent becomes disconnected (default 30)
# IDLE_TTL_MIN=30
# Consecutive daemon-down ticks before declaring all agents disconnected (default 3)
# HEALTH_FAILURES_MAX=3
