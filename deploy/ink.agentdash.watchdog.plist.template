<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent for scripts/emitter-watchdog.sh (every 5 min). No secrets inside:
     the script reads BACKEND_URL/ACCOUNT_TOKEN from the installed emitter plist.
     Install: cp to ~/Library/LaunchAgents/ink.agentdash.watchdog.plist, then
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ink.agentdash.watchdog.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ink.agentdash.watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/gordon/dev/agentdash-emitter/scripts/emitter-watchdog.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/gordon/Library/Logs/agentdash-watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gordon/Library/Logs/agentdash-watchdog.log</string>
</dict>
</plist>
